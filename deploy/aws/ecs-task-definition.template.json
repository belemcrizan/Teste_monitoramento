{
  "family": "vertice-surveillance-shadow",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "<ECS_EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<VERTICE_TASK_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "vertice",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/vertice-surveillance:<IMMUTABLE_TAG>",
      "essential": true,
      "readonlyRootFilesystem": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {"name": "VERTICE_ENV", "value": "aws-shadow"},
        {"name": "VERTICE_OBJECT_STORE", "value": "s3"},
        {"name": "VERTICE_EVENT_BUS", "value": "sqs"},
        {"name": "VERTICE_CASE_REPOSITORY", "value": "memory"},
        {"name": "VERTICE_AWS_REGION", "value": "<REGION>"},
        {"name": "VERTICE_S3_BUCKET", "value": "<EVIDENCE_BUCKET>"},
        {"name": "VERTICE_S3_PREFIX", "value": "shadow"},
        {"name": "VERTICE_SQS_QUEUE_URL", "value": "<QUEUE_URL>"}
      ],
      "secrets": [
        {
          "name": "VERTICE_BEDROCK_MODEL_ID",
          "valueFrom": "<APPROVED_MODEL_ID_PARAMETER_ARN>"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<LOG_GROUP>",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "vertice"
        }
      }
    }
  ]
}

